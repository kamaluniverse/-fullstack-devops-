# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and replace every placeholder.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────────────────────

# --- MongoDB ---
# Use a long, random password (e.g. `openssl rand -base64 32`).
MONGO_USER=proshop_admin
MONGO_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_PASSWORD
MONGO_DB=proshop

# Full connection URI. Inside Docker Compose this is assembled automatically,
# but set it explicitly for local development or MongoDB Atlas.
# Local/Compose: mongodb://USER:PASSWORD@mongo:27017/proshop?authSource=admin
# Atlas:         mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/proshop
MONGO_URI=mongodb://proshop_admin:REPLACE_WITH_A_STRONG_RANDOM_PASSWORD@mongo:27017/proshop?authSource=admin

# --- Backend ---
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Comma-separated list of allowed browser origins. Leave empty when the
# frontend and API share an origin through Nginx.
# CORS_ORIGIN=https://example.com
RATE_LIMIT_MAX=300

# Where locally-stored uploads live inside the backend container.
UPLOAD_DIR=/app/uploads

# --- Optional: Cloudinary image hosting ---
# When these are empty, uploads are written to UPLOAD_DIR and served at
# /uploads (persisted in the uploads-data Docker volume).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional: Stripe payments ---
# When empty, checkout uses the demo payment form and orders are created
# without charging a card.
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=

# --- Seeded administrator (used by `npm run seed:admin`) ---
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# --- Image registry / deployment (used by scripts/deploy.sh) ---
# Leave IMAGE_SOURCE=build for the simple single-host setup.
IMAGE_SOURCE=build
# For ECR:
# IMAGE_SOURCE=ecr
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# ECR_REPO_PREFIX=proshop
# TAG=latest
